# .env.example
# Salin file ini menjadi .env lalu isi nilai asli. File .env TIDAK di-commit
# (sudah di .gitignore). Jangan pernah commit kredensial asli.
#
# Prioritas pembacaan (lihat config/env.php):
#   1. Environment variable asli (SetEnv Apache / systemd Environment / export shell)
#   2. File .env di root project
#   3. Nilai default di dalam kode (config/database.example.php, config/openai.example.php)
#
# Catatan: nilai dengan karakter spesial (#, spasi) bungkus dengan tanda kutip,
# contoh: DB_PASSWORD="p@ss word#1"

# --- Database (config/database.php) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_marketing_rfm
DB_USER=root
DB_PASSWORD=

# --- OpenAI (config/openai.php) ---
# Kosongkan / biarkan placeholder jika fitur AI belum dipakai.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
